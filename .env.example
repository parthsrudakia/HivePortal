NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Read-only inventory API for internal tools/scripts (GET /api/inventory).
# Callers send it as `Authorization: Bearer <key>`. Leave blank to disable.
INVENTORY_API_KEY=

# Read-only tenant contact API (GET /api/tenants) — returns PII (names,
# emails, phones), so it uses its own key: inventory-key holders never gain
# access to tenant data. Leave blank to disable.
TENANTS_API_KEY=

# Utility statement intake for the statements agent
# (POST /api/utilities/statements). Write access to the utilities log only —
# its own key so the agent's token reads no tenant or inventory data. Leave
# blank to disable.
UTILITIES_API_KEY=

# Read-only credentials API (GET /api/credentials) — returns decrypted
# passwords, so it has its own key that no other API token unlocks. Every
# credential returned is written to credential_access_log. Leave blank to
# disable.
CREDENTIALS_API_KEY=

# Neutral (no "hive" anywhere) origin for tenant lease-signing links, e.g. a
# second *.vercel.app alias of this app. All signing links prefer it, and New
# York agreement sends REFUSE to go out without it — the portal's own domain
# contains "hive-portal", which unbranded NY emails must never expose. On this
# host the app serves only /sign/*; every other path 404s.
SIGN_ORIGIN=

# Random, unbranded origin (another *.vercel.app alias) for tenant
# emergency-contact form links: https://<host>/<token>. On this host the app
# serves only that form; every other path 404s. Request emails refuse to send
# without it.
EMERGENCY_FORM_ORIGIN=

# Resend — transactional email (rent/balance reminders, room-change & cleaning
# notices, lease-end heads-ups). NY tenants use Gmail instead (GMAIL_* below),
# which doesn't count against the Resend free tier.
RESEND_API_KEY=
RESEND_FROM=Hive Portal <onboarding@resend.dev>
RESEND_REPLY_TO=
# Free-tier guard: once a cap is hit, the rest of the day's emails are queued and
# sent the next day (drained by the daily cron). Defaults: 90/day, 3000/month.
RESEND_DAILY_CAP=90
RESEND_MONTHLY_CAP=3000

# Agreement email drafts (see docs/AGREEMENTS_SETUP.md)
# Personal Gmail — New York correspondence (no letterhead). Sends over SMTP with
# a Gmail App Password (needs 2-Step Verification on the account):
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# The Gmail App Password is also used over IMAP to verify sent agreements
# landed in the Sent folder — enable IMAP in the Gmail settings.
# M365 / Outlook work account — non-NY agreements (with letterhead)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REFRESH_TOKEN=
# SMS rent reminders (Zoom Phone). Texts go out alongside the email reminders
# (balance reminders + the monthly general reminder) to tenants with a phone on
# file. Needs a Zoom Phone number with SMS enabled and a Server-to-Server OAuth
# app with the phone_sms:write:admin scope. Leave blank to disable SMS.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SMS_FROM=
# Operator's own mobile — added to group threads by the bot's send_text tool
OPERATOR_PHONE=

# Origin serving the email open-tracking pixel (/api/o/<id>), normally the
# portal's own URL. Unset = emails go out without a pixel (untracked).
EMAIL_TRACKING_ORIGIN=
